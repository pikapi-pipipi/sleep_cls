{
    "dataset": {
        "name": "EFSleep",
        "eeg_channel": "Fpz",
        "num_splits": 5,
        "seq_len": 10,
        "target_idx": -1,
        "root_dir": "./"
    },

    "backbone": {
        "name": "SleePyCo",
        "init_weights": false,
        "dropout": false
    },

    "feature_pyramid": {
        "dim": 128,
        "num_scales": 3
    },

    "Transformer":{
        "name": "AgentTransformer",
        "feedforward_dim": 128,
        "model_dim": 128,
        "dropout": false,
        "eeg_pos_enc": {
            "seq_len": 1200,
            "dropout": false
        },
        "ppg_pos_enc": {
            "seq_len": 300,
            "dropout": false
        },
        "hemo_pos_enc": {
            "seq_len": 300,
            "dropout": false
        }
    },

    "classifier": {
        "model_dim": 128,
        "pool": "attn",
        "dropout": false,
        "num_classes": 5
    },

    "training_params": {
        "mode": "freezefinetune",
        "max_epochs": 400,
        "batch_size": 8,
        "target_lr": 0.0005,
        "weight_decay": 0.000001,
        "val_period": 500,
        "early_stopping": {
            "mode": "min",
            "patience": 10
        }
    }
}